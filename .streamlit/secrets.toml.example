# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud app's "Secrets" (Settings -> Secrets).
# Never commit the real file.

# ---- Claude (AI assistance)
ANTHROPIC_API_KEY = "sk-ant-..."
SI2_AI_MODEL = "claude-sonnet-5-5"

# ---- Permanent storage for SME decisions and approvals (pick one)
SI2_STATE_BACKEND = "postgres"
SI2_DATABASE_URL = "postgresql://si2_app:PASSWORD@your-server.postgres.database.azure.com:5432/si2?sslmode=require"
# SI2_STATE_BACKEND = "mssql"   # SQL Server on your network (Windows Authentication), see run_si2_sqlserver.bat

# ---- Company single sign-on (OpenID Connect): Microsoft Entra ID example
[auth]
redirect_uri = "https://si2-migrate.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
