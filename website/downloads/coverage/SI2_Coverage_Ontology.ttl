si2c:Term_CP_BPP_LIMIT a owl:Class ;
    rdfs:label "Business Personal Property: LIMIT" ;
    rdfs:subClassOf si2c:Limit ;
    si2c:rule "Insured value" ;
    si2c:termCode "LIMIT" .

si2c:Term_GL_MED_LIMIT a owl:Class ;
