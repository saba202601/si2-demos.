    si2c:value "Cancellation and notice per state law" .

si2c:Eff_END_HO_ROOF_ACV_1 a si2c:EndorsementEffect ;
    si2c:effectType "Restrict" ;
    si2c:targetCoverage si2c:Cov_HO_A ;
    si2c:termCode "VALUATION" ;
    si2c:value "ACV for roof surfacing" .

si2c:Eff_END_HO_SPP_1 a si2c:EndorsementEffect ;
    si2c:effectType "Add" ;
    si2c:targetCoverage si2c:Cov_HO_SPP ;
    si2c:value "schedule" .

si2c:Eff_END_WC_OTHER_STATES_1 a si2c:EndorsementEffect ;
    si2c:effectType "Broaden" ;
    si2c:targetCoverage si2c:Cov_WC_PART1 ;
    si2c:value "States listed in 3.C" .

