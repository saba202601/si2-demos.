si2c:AutoLiability a owl:Class ;
    rdfs:label "AutoLiability" ;
    rdfs:subClassOf si2c:BodilyInjuryPropertyDamageLiability ;
    skos:definition "Liability from owning or using autos." .

si2c:BodilyInjuryPropertyDamageLiability a owl:Class ;
    rdfs:label "BodilyInjuryPropertyDamageLiability" ;
    rdfs:subClassOf si2c:LiabilityCoverage ;
    skos:definition "Bodily injury and property damage to others." .

si2c:Cov_CA_PIP a owl:Class ;
    rdfs:label "Personal Injury Protection" ;
    rdfs:subClassOf si2c:PersonalInjuryProtection ;
    skos:notation "CA_PIP" ;
    si2c:attachLevel si2c:Level_Line ;
    si2c:hasTermType si2c:Term_CA_PIP_LIMIT ;
    si2c:lob "CA" .

si2c:Cov_CP_BLDG a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf si2c:CommercialBuildingCoverage ;
    skos:notation "CP_BLDG" ;
    si2c:attachLevel si2c:Level_Object ;
