si2c:Term_GL_PAI_LIMIT a owl:Class ;
    rdfs:label "Coverage B - Personal and Advertising Injury: LIMIT" ;
    rdfs:subClassOf si2c:PerPersonLimit ;
    si2c:rule "Equal to each occurrence" ;
