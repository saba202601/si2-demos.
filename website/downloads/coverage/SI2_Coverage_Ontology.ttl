    rdfs:subClassOf si2c:PersonalPropertyCoverage ;
    skos:notation "HO_SPP" ;
    si2c:attachLevel si2c:Level_Policy ;
    si2c:hasTermType si2c:Term_HO_SPP_LIMIT ;
