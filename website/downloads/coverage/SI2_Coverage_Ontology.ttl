si2c:Coverage a owl:Class ;
    rdfs:label "Coverage" ;
    skos:definition "A promise to pay or defend for a defined loss, under stated terms." .

si2c:InsuredObject a owl:Class ;
    rdfs:label "Insured object" .

si2c:LiabilityCoverage a owl:Class ;
    rdfs:label "LiabilityCoverage" ;
    rdfs:subClassOf si2c:Coverage ;
