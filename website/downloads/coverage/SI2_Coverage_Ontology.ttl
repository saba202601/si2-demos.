si2c:Sublimit a owl:Class ;
    rdfs:label "Sublimit" ;
    rdfs:subClassOf si2c:Limit ;
    skos:definition "A smaller limit inside a parent limit." .

si2c:Cov_HO_EQ a owl:Class ;
    rdfs:label "Earthquake" ;
    rdfs:subClassOf si2c:DwellingCoverage ;
