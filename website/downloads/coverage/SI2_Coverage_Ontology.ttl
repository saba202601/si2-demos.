si2c:AddCoverageEndorsement a owl:Class ;
    rdfs:label "AddCoverageEndorsement" ;
    rdfs:subClassOf si2c:Endorsement ;
    skos:definition "Adds a coverage." .

si2c:AggregateLimit a owl:Class ;
    rdfs:label "AggregateLimit" ;
