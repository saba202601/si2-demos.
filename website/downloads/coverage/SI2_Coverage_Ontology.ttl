    si2c:termCode "DED" .

si2c:Term_CA_COMP_DED a owl:Class ;
    rdfs:label "Comprehensive: DED" ;
    rdfs:subClassOf si2c:FlatDeductible ;
    si2c:options "500, 1000, 2500" ;
    si2c:rule "Default 1000" ;
    si2c:termCode "DED" .

si2c:Term_CA_LIAB_CSL a owl:Class ;
    rdfs:label "Auto Liability: CSL" ;
    rdfs:subClassOf si2c:CombinedSingleLimit ;
    si2c:options "500000, 1000000, 2000000" ;
    si2c:rule "Default 1000000" ;
    si2c:termCode "CSL" .

si2c:Term_CA_PIP_LIMIT a owl:Class ;
    rdfs:label "Personal Injury Protection: LIMIT" ;
    rdfs:subClassOf si2c:PerPersonLimit ;
    si2c:rule "State minimum" ;
    si2c:termCode "LIMIT" .

si2c:Term_CA_UM_LIMIT a owl:Class ;
    rdfs:label "Uninsured Motorists: LIMIT" ;
    rdfs:subClassOf si2c:CombinedSingleLimit ;
    si2c:rule "Up to CSL" ;
    si2c:termCode "LIMIT" .

si2c:Term_CP_BI_LIMIT a owl:Class ;
