    rdfs:label "Coverage A - Dwelling: LIMIT" ;
    rdfs:subClassOf si2c:Limit ;
    si2c:rule "Insured to replacement cost" ;
    si2c:termCode "LIMIT" .

si2c:Term_HO_A_VALUATION a owl:Class ;
    rdfs:label "Coverage A - Dwelling: VALUATION" ;
    rdfs:subClassOf si2c:Valuation ;
    si2c:options "RC, ACV" ;
    si2c:rule "Default RC" ;
