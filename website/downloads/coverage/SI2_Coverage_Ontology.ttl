si2c:Vehicle a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:subClassOf si2c:InsuredObject .

si2c:AttachLevels a skos:ConceptScheme ;
    rdfs:label "Coverage attachment levels" .

si2c:Cov_PA_PIP a owl:Class ;
    rdfs:label "Personal Injury Protection" ;
    rdfs:subClassOf si2c:PersonalInjuryProtection ;
    skos:notation "PA_PIP" ;
    si2c:attachLevel si2c:Level_Line ;
    si2c:hasTermType si2c:Term_PA_PIP_LIMIT ;
    si2c:lob "PA" .

si2c:CoverageTerm a owl:Class ;
    rdfs:label "CoverageTerm" ;
    skos:definition "A value that defines how much or how a coverage pays." .

si2c:PerOccurrenceLimit a owl:Class ;
    rdfs:label "PerOccurrenceLimit" ;
    rdfs:subClassOf si2c:Limit ;
    skos:definition "Most paid for one occurrence." .

si2c:PropertyCoverage a owl:Class ;
    rdfs:label "PropertyCoverage" ;
    rdfs:subClassOf si2c:FirstPartyCoverage ;
    skos:definition "Direct physical loss to property." .

si2c:Cov_HO_A a owl:Class ;
    rdfs:label "Coverage A - Dwelling" ;
    rdfs:subClassOf si2c:DwellingCoverage ;
    skos:notation "HO_A" ;
    si2c:attachLevel si2c:Level_Object ;
    si2c:attachesToObjectType si2c:Dwelling ;
    si2c:hasTermType si2c:Term_HO_A_AOP_DED,
        si2c:Term_HO_A_HURR_DED,
        si2c:Term_HO_A_LIMIT,
        si2c:Term_HO_A_VALUATION ;
    si2c:lob "HO" .

si2c:Cov_WC_PART1 a owl:Class ;
    rdfs:label "Part One - Workers' Compensation" ;
    rdfs:subClassOf si2c:WorkersCompensationBenefits ;
    skos:notation "WC_PART1" ;
    si2c:attachLevel si2c:Level_Line ;
    si2c:hasTermType si2c:Term_WC_PART1_LIMIT ;
    si2c:lob "WC" .

si2c:Endorsement a owl:Class ;
    rdfs:label "Endorsement" ;
    skos:definition "A form that changes the policy." .

si2c:FlatDeductible a owl:Class ;
    rdfs:label "FlatDeductible" ;
    rdfs:subClassOf si2c:Deductible ;
    skos:definition "A fixed amount." .

si2c:Level_Object a skos:Concept ;
    skos:definition "Attaches to one insured object" ;
    skos:inScheme si2c:AttachLevels ;
    skos:prefLabel "Object" .

si2c:Level_Coverage a skos:Concept ;
    skos:definition "Attaches to another coverage and follows it" ;
    skos:inScheme si2c:AttachLevels ;
    skos:prefLabel "Coverage" .

si2c:PerPersonLimit a owl:Class ;
    rdfs:label "PerPersonLimit" ;
    rdfs:subClassOf si2c:Limit ;
    skos:definition "Most paid for one person." .

si2c:Limit a owl:Class ;
    rdfs:label "Limit" ;
    rdfs:subClassOf si2c:CoverageTerm ;
    skos:definition "Most the coverage pays." .

si2c:EndorsementEffect a owl:Class ;
    rdfs:label "Endorsement effect" .

si2c:Level_Line a skos:Concept ;
    skos:definition "Applies to one line or coverage part in the policy" ;
    skos:inScheme si2c:AttachLevels ;
    skos:prefLabel "Line" .

si2c:CoverageApplicability a owl:Class ;
    rdfs:label "Coverage applicability" .

