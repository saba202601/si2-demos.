si2:POLICY_EFFECTIVE_DATE a owl:DatatypeProperty ;
    rdfs:label "Policy effective date" ;
    rdfs:domain si2:Policy ;
    rdfs:range xsd:date ;
    skos:altLabel "EFF_DT",
        "PeriodStart",
        "inception_date" ;
    skos:definition "Date the policy term starts." ;
    si2:mapsFrom "GW_PC:PeriodStart",
        "HOMEBUILT:inception_date",
        "LEGACY:EFF_DT" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing,
        si2:MOD_Claims,
        si2:MOD_Policy,
        si2:MOD_Reporting .

si2:POLICY_EXPIRATION_DATE a owl:DatatypeProperty ;
    rdfs:label "Policy expiration date" ;
    rdfs:domain si2:Policy ;
    rdfs:range xsd:date ;
    skos:altLabel "EXP_DT",
        "PeriodEnd" ;
    skos:definition "Date the policy term ends." ;
    si2:mapsFrom "GW_PC:PeriodEnd",
        "LEGACY:EXP_DT" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing,
        si2:MOD_Claims,
        si2:MOD_Policy,
        si2:MOD_Reporting .

si2:POLICY_NUMBER a owl:DatatypeProperty ;
    rdfs:label "Policy number" ;
    rdfs:domain si2:Policy ;
    rdfs:range xsd:string ;
    skos:altLabel "PM-POLICY-NO",
        "POL_NO",
        "PolicyNumber",
        "policy_num" ;
    skos:definition "Identifier of the policy term." ;
    si2:mapsFrom "GW_PC:PolicyNumber",
        "HOMEBUILT:policy_num",
        "LEGACY:PM-POLICY-NO",
        "LEGACY:POL_NO" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing,
        si2:MOD_Claims,
        si2:MOD_Finance,
        si2:MOD_Policy,
        si2:MOD_Reinsurance,
        si2:MOD_Reporting .

si2:PRODUCER_CODE a owl:DatatypeProperty ;
    rdfs:label "Producer code" ;
    rdfs:domain si2:Producer ;
    rdfs:range xsd:string ;
    skos:altLabel "AGT_NO",
        "Agency number",
        "ProducerCode" ;
    skos:definition "Agency / broker code." ;
    si2:acordForm "125" ;
    si2:mapsFrom "ACORD:ACORD 125: Producer code",
        "AMS:Agency number",
        "GW_PC:ProducerCode",
        "LEGACY:AGT_NO" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing,
        si2:MOD_Finance,
        si2:MOD_Policy .

si2:PRODUCTS_AGGREGATE_LIMIT a owl:DatatypeProperty ;
    rdfs:label "Products-completed operations aggregate" ;
    rdfs:domain si2:Coverage ;
    rdfs:range xsd:decimal ;
    skos:altLabel "PCO_AGG" ;
    skos:definition "Aggregate for products and completed work." ;
    si2:mapsFrom "LEGACY:PCO_AGG" ;
    si2:usedInLob si2:LOB_GL ;
    si2:usedInModule si2:MOD_Claims,
        si2:MOD_Policy .

si2:PRODUCT_CODE a owl:DatatypeProperty ;
    rdfs:label "Product and edition" ;
    rdfs:domain si2:Policy ;
    rdfs:range xsd:string ;
    skos:altLabel "PROD_CD",
        "ProductCode",
        "Program" ;
    skos:definition "Product and form edition (product key)." ;
    si2:mapsFrom "GW_PC:ProductCode",
        "GW_PC:Program",
        "LEGACY:PROD_CD" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Policy,
        si2:MOD_Reporting .

si2:PolicyTransaction_amends_Policy a owl:ObjectProperty ;
    rdfs:comment "cardinality 1" ;
    rdfs:domain si2:PolicyTransaction ;
    rdfs:range si2:Policy ;
    rdfs:subPropertyOf si2:amends .

si2:Policy_hasNamedInsured_Party a owl:ObjectProperty ;
    rdfs:comment "cardinality 1..*" ;
    rdfs:domain si2:Policy ;
    rdfs:range si2:Party ;
    rdfs:subPropertyOf si2:hasNamedInsured .

si2:Policy_placedBy_Producer a owl:ObjectProperty ;
    rdfs:comment "cardinality 1" ;
    rdfs:domain si2:Policy ;
    rdfs:range si2:Producer ;
    rdfs:subPropertyOf si2:placedBy .

si2:Premium_chargedFor_Coverage a owl:ObjectProperty ;
    rdfs:comment "cardinality 1" ;
    rdfs:domain si2:Premium ;
    rdfs:range si2:Coverage ;
    rdfs:subPropertyOf si2:chargedFor .

si2:RATE_CA_1 a si2:RatingStep ;
    rdfs:label "Commercial Auto step 1: Liability base" ;
    si2:formula "base rate[STATE, TERRITORY] x factor[VEHICLE_TYPE, VEHICLE_USE, RADIUS_CLASS]" ;
    si2:stepNumber 1 ;
    si2:usedInLob si2:LOB_CA ;
    si2:usesElement si2:RADIUS_CLASS,
        si2:STATE,
        si2:TERRITORY,
        si2:VEHICLE_TYPE,
        si2:VEHICLE_USE .

si2:RATE_CA_2 a si2:RatingStep ;
    rdfs:label "Commercial Auto step 2: Increased limits" ;
    si2:formula "x ILF[CA_LIABILITY_LIMIT]" ;
    si2:stepNumber 2 ;
    si2:usedInLob si2:LOB_CA ;
    si2:usesElement si2:CA_LIABILITY_LIMIT .

si2:RATE_CA_3 a si2:RatingStep ;
    rdfs:label "Commercial Auto step 3: Physical damage" ;
    si2:formula "COST_NEW x rate[VEHICLE_TYPE, age] x deductible factor" ;
    si2:stepNumber 3 ;
    si2:usedInLob si2:LOB_CA ;
    si2:usesElement si2:COST_NEW,
        si2:VEHICLE_TYPE .

si2:RATE_CA_4 a si2:RatingStep ;
    rdfs:label "Commercial Auto step 4: State coverages" ;
    si2:formula "+ PIP[STATE] + UM[STATE, UM_LIMIT]" ;
    si2:stepNumber 4 ;
    si2:usedInLob si2:LOB_CA ;
    si2:usesElement si2:STATE,
        si2:UM_LIMIT .

si2:RATE_CP_1 a si2:RatingStep ;
    rdfs:label "Commercial Property step 1: Building base premium" ;
    si2:formula "BUILDING_LIMIT / 100 x base rate[CONSTRUCTION_CLASS, PROTECTION_CLASS]" ;
    si2:stepNumber 1 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:BUILDING_LIMIT,
        si2:CONSTRUCTION_CLASS,
        si2:PROTECTION_CLASS .

si2:RATE_CP_2 a si2:RatingStep ;
    rdfs:label "Commercial Property step 2: Contents base premium" ;
    si2:formula "BPP_LIMIT / 100 x contents rate[CONSTRUCTION_CLASS, PROTECTION_CLASS]" ;
    si2:stepNumber 2 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:BPP_LIMIT,
        si2:CONSTRUCTION_CLASS,
        si2:PROTECTION_CLASS .

si2:RATE_CP_3 a si2:RatingStep ;
    rdfs:label "Commercial Property step 3: Causes of loss" ;
    si2:formula "x factor[CAUSES_OF_LOSS_FORM]" ;
    si2:stepNumber 3 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:CAUSES_OF_LOSS_FORM .

si2:RATE_CP_4 a si2:RatingStep ;
    rdfs:label "Commercial Property step 4: Sprinkler credit" ;
    si2:formula "x factor[SPRINKLER]" ;
    si2:stepNumber 4 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:SPRINKLER .

si2:RATE_CP_5 a si2:RatingStep ;
    rdfs:label "Commercial Property step 5: Deductible credit" ;
    si2:formula "x factor[DEDUCTIBLE_TYPE, DEDUCTIBLE_AMOUNT or WIND_DEDUCTIBLE_PCT]" ;
    si2:stepNumber 5 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:DEDUCTIBLE_AMOUNT,
        si2:DEDUCTIBLE_TYPE,
        si2:WIND_DEDUCTIBLE_PCT .

si2:RATE_CP_6 a si2:RatingStep ;
    rdfs:label "Commercial Property step 6: Territory (state key)" ;
    si2:formula "x factor[STATE, TERRITORY]" ;
    si2:stepNumber 6 ;
    si2:usedInLob si2:LOB_CP ;
    si2:usesElement si2:STATE,
        si2:TERRITORY .

si2:RATE_GL_1 a si2:RatingStep ;
    rdfs:label "General Liability step 1: Premises / operations" ;
    si2:formula "sum over classes: GL_EXPOSURE / basis divisor x rate[STATE, TERRITORY, GL_CLASS_CODE]" ;
    si2:stepNumber 1 ;
    si2:usedInLob si2:LOB_GL ;
    si2:usesElement si2:GL_CLASS_CODE,
        si2:GL_EXPOSURE,
        si2:STATE,
        si2:TERRITORY .

si2:RATE_GL_2 a si2:RatingStep ;
    rdfs:label "General Liability step 2: Increased limits" ;
    si2:formula "x ILF[EACH_OCCURRENCE_LIMIT, GENERAL_AGGREGATE_LIMIT]" ;
    si2:stepNumber 2 ;
    si2:usedInLob si2:LOB_GL ;
    si2:usesElement si2:EACH_OCCURRENCE_LIMIT,
        si2:GENERAL_AGGREGATE_LIMIT .

si2:RATE_GL_3 a si2:RatingStep ;
    rdfs:label "General Liability step 3: Claims-made step" ;
    si2:formula "x step factor[years since RETROACTIVE_DATE] (claims-made only)" ;
    si2:stepNumber 3 ;
    si2:usedInLob si2:LOB_GL ;
    si2:usesElement si2:RETROACTIVE_DATE .

si2:RATE_WC_1 a si2:RatingStep ;
    rdfs:label "Workers' Compensation step 1: Manual premium" ;
    si2:formula "sum over classes: ESTIMATED_PAYROLL / 100 x rate[STATE, WC_CLASS_CODE]" ;
    si2:stepNumber 1 ;
    si2:usedInLob si2:LOB_WC ;
    si2:usesElement si2:ESTIMATED_PAYROLL,
        si2:STATE,
        si2:WC_CLASS_CODE .

si2:RATE_WC_2 a si2:RatingStep ;
    rdfs:label "Workers' Compensation step 2: Experience rating" ;
    si2:formula "x EXPERIENCE_MOD" ;
    si2:stepNumber 2 ;
    si2:usedInLob si2:LOB_WC ;
    si2:usesElement si2:EXPERIENCE_MOD .

si2:RATE_WC_3 a si2:RatingStep ;
    rdfs:label "Workers' Compensation step 3: Schedule rating" ;
    si2:formula "x (1 + schedule credit/debit, capped by state)" ;
    si2:stepNumber 3 ;
    si2:usedInLob si2:LOB_WC .

si2:RATE_WC_4 a si2:RatingStep ;
    rdfs:label "Workers' Compensation step 4: Premium discount and expense constant" ;
    si2:formula "- premium discount[STATE, premium size] + expense constant[STATE]" ;
    si2:stepNumber 4 ;
    si2:usedInLob si2:LOB_WC ;
    si2:usesElement si2:STATE .

si2:RULE_CL_WC_001 a si2:BusinessRule ;
    rdfs:label "AWW required for indemnity" ;
    si2:action "Block payment" ;
    si2:condition "indemnity payment AND INJURED_WORKER_AWW is null" ;
    si2:key_company "*" ;
    si2:key_country "*" ;
    si2:key_effective_from "2025-01-01" ;
    si2:key_effective_to "9999-12-31" ;
    si2:key_line "Commercial" ;
    si2:key_lob "WC" ;
    si2:key_module "Claims" ;
    si2:key_object "*" ;
    si2:key_product "*" ;
    si2:key_state "*" ;
    si2:phase "Validation" ;
    si2:usesElement si2:INJURED_WORKER_AWW .

