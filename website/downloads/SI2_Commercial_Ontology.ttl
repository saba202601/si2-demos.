si2:NAMED_INSURED_NAME a owl:DatatypeProperty ;
    rdfs:label "Named insured name" ;
    rdfs:domain si2:Party ;
    rdfs:range xsd:string ;
    skos:altLabel "Applicant name",
        "INSD_NAME",
        "PrimaryNamedInsured" ;
    skos:definition "Legal name of the first named insured." ;
    si2:acordForm "125" ;
    si2:mapsFrom "ACORD:ACORD 125: Named insured name",
        "AMS:Applicant name",
        "GW_PC:PrimaryNamedInsured",
        "LEGACY:INSD_NAME" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing,
        si2:MOD_Claims,
        si2:MOD_Policy .

si2:PAID_LOSS a owl:DatatypeProperty ;
    rdfs:label "Paid loss" ;
    rdfs:domain si2:ClaimFinancial ;
    rdfs:range xsd:decimal ;
    skos:altLabel "PD_LOSS",
        "PaymentAmount" ;
    skos:definition "Loss payment amount." ;
    si2:mapsFrom "GW_PC:PaymentAmount",
        "LEGACY:PD_LOSS" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Claims,
        si2:MOD_Finance,
        si2:MOD_Reinsurance,
        si2:MOD_Reporting .

si2:PAYMENT_PLAN a owl:DatatypeProperty ;
    rdfs:label "Payment plan" ;
    rdfs:domain si2:BillingAccount ;
    rdfs:range xsd:string ;
    skos:altLabel "BillingPlan",
        "PAY_PLAN" ;
    skos:definition "How premium is billed." ;
    si2:hasPickList si2:PL_PAYMENT_PLAN ;
    si2:mapsFrom "GW_PC:BillingPlan",
        "LEGACY:PAY_PLAN" ;
    si2:usedInLob si2:LOB_CA,
        si2:LOB_CP,
        si2:LOB_GL,
        si2:LOB_WC ;
    si2:usedInModule si2:MOD_Billing .

si2:PERSONAL_ADV_INJURY_LIMIT a owl:DatatypeProperty ;
