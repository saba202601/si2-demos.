si2:key_company a owl:DatatypeProperty ;
    rdfs:label "company" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Writing company / paper. Admitted paper follows filed rates and forms; E&S adds surplus lines tax and stamping fees and is not rate-filed in most states." .

si2:key_country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Country of the risk or contract. Laws, currency, address format and which lines exist (no private workers' comp in Canada; employers' liability compulsory in Great Britain)." .

si2:key_effective_from a owl:DatatypeProperty ;
    rdfs:label "effective_from" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Effective dates. Nothing is deleted: a change ends one row and starts another." .

si2:key_effective_to a owl:DatatypeProperty ;
    rdfs:label "effective_to" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Effective dates. Nothing is deleted: a change ends one row and starts another." .

si2:key_line a owl:DatatypeProperty ;
    rdfs:label "line" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Personal or commercial line. Separates personal from commercial vocabularies." .

si2:key_lob a owl:DatatypeProperty ;
    rdfs:label "lob" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Line of business. Which coverages, objects and rating apply." .

si2:key_module a owl:DatatypeProperty ;
    rdfs:label "module" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Where the element is used. Same meaning in every module; applicability and requiredness can differ." .

si2:key_object a owl:DatatypeProperty ;
    rdfs:label "object" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Risk object the element describes. An element belongs to one object, wherever it is used." .

si2:key_product a owl:DatatypeProperty ;
    rdfs:label "product" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "Product and form edition. Products change by edition; old policies keep the edition they were written on." .

si2:key_state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:domain si2:Applicability ;
    rdfs:subPropertyOf si2:contextKey ;
    skos:definition "State, province or territory. Filed rates, forms, mandatory coverages, bureaus. Most variation lives here." .

